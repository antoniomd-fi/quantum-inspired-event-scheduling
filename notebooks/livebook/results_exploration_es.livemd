# Exploración Reproducible De Resultados

Este Livebook resume los resultados principales del experimento de scheduling
event-driven con estrategias clásicas, QUBO y validación QAOA en instancias
pequeñas.

El objetivo es facilitar una inspección reproducible de los CSV curados sin
depender de herramientas externas.

## Carga De Datos

```elixir
defmodule ResultsTable do
  @moduledoc false

  @repo_root Path.expand("../..", __DIR__)

  def read_csv(relative_path) do
    path = Path.join(@repo_root, relative_path)

    path
    |> File.read!()
    |> String.split(~r/\R/, trim: true)
    |> parse_csv()
  end

  def first_row(relative_path) do
    relative_path
    |> read_csv()
    |> List.first()
  end

  def table(rows, columns) do
    header = columns |> Enum.map(fn {_key, label} -> label end) |> Enum.join(" | ")
    separator = columns |> Enum.map(fn _ -> "---" end) |> Enum.join(" | ")

    body =
      rows
      |> Enum.map(fn row ->
        values =
          columns
          |> Enum.map(fn {key, _label} -> row |> Map.fetch!(key) |> format() end)
          |> Enum.join(" | ")

        "| #{values} |"
      end)
      |> Enum.join("\n")

    "| #{header} |\n| #{separator} |\n#{body}"
  end

  def print_table(rows, columns) do
    rows
    |> table(columns)
    |> IO.puts()
  end

  def percent(value), do: "#{Float.round(value * 100, 2)}%"
  def signed_percent(value) when value > 0, do: "+#{Float.round(value, 2)}%"
  def signed_percent(value), do: "#{Float.round(value, 2)}%"
  def signed_float(value) when value > 0, do: "+#{Float.round(value, 4)}"
  def signed_float(value), do: "#{Float.round(value, 4)}"
  def seconds(value), do: "#{Float.round(value, 2)} s"
  def p_value(value) when value == 0.0, do: "0.000000"
  def p_value(value), do: :erlang.float_to_binary(value, decimals: 6)

  defp parse_csv([header_line | rows]) do
    headers = String.split(header_line, ",")

    Enum.map(rows, fn row ->
      values = String.split(row, ",")

      headers
      |> Enum.zip(values)
      |> Map.new(fn {key, value} -> {key, cast(value)} end)
    end)
  end

  defp cast("true"), do: true
  defp cast("false"), do: false

  defp cast(value) do
    value = String.trim(value)

    cond do
      String.match?(value, ~r/^-?\d+$/) -> String.to_integer(value)
      String.match?(value, ~r/^[+-]?(\d+(\.\d*)?|\.\d+)([eE][+-]?\d+)?$/) -> value |> normalize_float() |> String.to_float()
      true -> value
    end
  end

  defp normalize_float(value) do
    if (String.contains?(value, "e") or String.contains?(value, "E")) and not String.contains?(value, ".") do
      Regex.replace(~r/^([+-]?\d+)([eE][+-]?\d+)$/, value, "\\1.0\\2")
    else
      value
    end
  end

  defp format(value) when is_float(value), do: :erlang.float_to_binary(value, decimals: 4)
  defp format(value), do: to_string(value)
end
```

## Resultado General

```elixir
v2 = ResultsTable.first_row("results/processed/extended_event_driven_matrix/summary.csv")
v3 = ResultsTable.first_row("results/processed/targeted_stress_matrix/overall_summary.csv")
qaoa = ResultsTable.first_row("results/processed/qaoa_validation_small_matrix/aggregate.csv")

%{
  "escenarios_generales_v2" => v2["generated_scenario_count"],
  "victorias_qubo_v1_v2" => "#{v2["qubo_v1_wins_best_classical_count"]}/#{v2["generated_scenario_count"]}",
  "dentro_5_por_ciento_v2" => "#{v2["qubo_v1_within_5pct_best_classical_count"]}/#{v2["generated_scenario_count"]}",
  "comparaciones_dirigidas_v3" => v3["comparisons"],
  "victorias_qubo_v1_v3" => "#{v3["objective_win_count"]}/#{v3["comparisons"]}",
  "senal_hibrida_v3" => "#{v3["hybrid_activation_signal_count"]}/#{v3["comparisons"]}",
  "qaoa_acierto_exacto" => ResultsTable.percent(qaoa["exact_match_rate"])
}
```

## Matriz Dirigida

La matriz dirigida evalúa perfiles donde se combinan ráfagas, carga alta,
eventos críticos, heterogeneidad de workers y presión de starvation/fairness.
Aquí no buscamos que QUBO gane siempre, sino identificar cuándo aporta una señal
razonable para una arquitectura híbrida.

```elixir
v3_rows =
  "results/processed/targeted_stress_matrix/profile_load_summary.csv"
  |> ResultsTable.read_csv()
  |> Enum.map(fn row ->
    %{
      "profile" => row["profile"],
      "load_level" => row["load_level"],
      "objective_win_rate" => ResultsTable.percent(row["objective_win_rate"]),
      "within_5pct_objective_rate" => ResultsTable.percent(row["within_5pct_objective_rate"]),
      "hybrid_activation_signal_rate" => ResultsTable.percent(row["hybrid_activation_signal_rate"]),
      "objective_gap_pct_mean" => ResultsTable.signed_percent(row["objective_gap_pct_mean"]),
      "critical_delta_mean" => ResultsTable.signed_float(row["critical_delta_mean"]),
      "p99_improvement_pct_mean" => ResultsTable.signed_percent(row["p99_improvement_pct_mean"])
    }
  end)

ResultsTable.print_table(v3_rows, [
  {"profile", "Perfil"},
  {"load_level", "Carga"},
  {"objective_win_rate", "Victorias"},
  {"within_5pct_objective_rate", "Dentro 5%"},
  {"hybrid_activation_signal_rate", "Señal híbrida"},
  {"objective_gap_pct_mean", "Brecha objetivo"},
  {"critical_delta_mean", "Delta críticos"},
  {"p99_improvement_pct_mean", "Mejora p99"}
])
```

## Brecha Objetivo E Intervalos De Confianza

Las brechas negativas indican que QUBO v1 superó a la mejor heurística clásica
según el coste objetivo. Esta tabla es el punto principal para decidir dónde el
especialista QUBO resulta competitivo.

```elixir
objective_gap_rows =
  "results/processed/targeted_stress_matrix/profile_load_summary.csv"
  |> ResultsTable.read_csv()
  |> Enum.map(fn row ->
    %{
      "profile" => row["profile"],
      "load_level" => row["load_level"],
      "mean_gap" => ResultsTable.signed_percent(row["objective_gap_pct_mean"]),
      "ci_low" => ResultsTable.signed_percent(row["objective_gap_pct_ci95_low"]),
      "ci_high" => ResultsTable.signed_percent(row["objective_gap_pct_ci95_high"]),
      "wins" => "#{row["objective_win_count"]}/#{row["comparisons"]}",
      "within_5pct" => "#{row["within_5pct_objective_count"]}/#{row["comparisons"]}"
    }
  end)

ResultsTable.print_table(objective_gap_rows, [
  {"profile", "Perfil"},
  {"load_level", "Carga"},
  {"mean_gap", "Brecha media"},
  {"ci_low", "IC inferior"},
  {"ci_high", "IC superior"},
  {"wins", "Victorias"},
  {"within_5pct", "Dentro 5%"}
])
```

## Protección De Eventos Críticos

Esta tabla muestra si QUBO v1 protege mejor los eventos críticos que la mejor
heurística clásica por coste objetivo. Es importante porque el valor más fuerte
de la arquitectura híbrida no siempre es bajar la latencia global, sino mejorar
el comportamiento bajo presión de eventos críticos.

```elixir
critical_rows =
  "results/processed/targeted_stress_matrix/profile_load_summary.csv"
  |> ResultsTable.read_csv()
  |> Enum.map(fn row ->
    %{
      "profile" => row["profile"],
      "load_level" => row["load_level"],
      "critical_delta" => ResultsTable.signed_float(row["critical_delta_mean"]),
      "ci_low" => ResultsTable.signed_float(row["critical_delta_ci95_low"]),
      "ci_high" => ResultsTable.signed_float(row["critical_delta_ci95_high"]),
      "hybrid_signal" => ResultsTable.percent(row["hybrid_activation_signal_rate"])
    }
  end)

ResultsTable.print_table(critical_rows, [
  {"profile", "Perfil"},
  {"load_level", "Carga"},
  {"critical_delta", "Delta críticos"},
  {"ci_low", "IC inferior"},
  {"ci_high", "IC superior"},
  {"hybrid_signal", "Señal híbrida"}
])
```

## Trade-Off De Latencia

Los valores positivos indican que QUBO v1 mejoró la latencia p99 respecto a la
mejor heurística clásica por coste objetivo. El promedio negativo es una
limitación útil: la formulación QUBO puede proteger eventos críticos y, aun así,
empeorar la cola de latencia en ciertos perfiles.

```elixir
latency_rows =
  "results/processed/targeted_stress_matrix/profile_load_summary.csv"
  |> ResultsTable.read_csv()
  |> Enum.map(fn row ->
    %{
      "profile" => row["profile"],
      "load_level" => row["load_level"],
      "p99_mean" => ResultsTable.signed_percent(row["p99_improvement_pct_mean"]),
      "ci_low" => ResultsTable.signed_percent(row["p99_improvement_pct_ci95_low"]),
      "ci_high" => ResultsTable.signed_percent(row["p99_improvement_pct_ci95_high"]),
      "starvation_delta" => row["starvation_delta_mean"]
    }
  end)

ResultsTable.print_table(latency_rows, [
  {"profile", "Perfil"},
  {"load_level", "Carga"},
  {"p99_mean", "Mejora p99"},
  {"ci_low", "IC inferior"},
  {"ci_high", "IC superior"},
  {"starvation_delta", "Delta starvation"}
])
```

## Pruebas Pareadas

Las pruebas de signo comparan victorias y derrotas por seed. Sirven para separar
los casos donde QUBO v1 realmente domina de aquellos donde solo queda cerca.

```elixir
sign_tests =
  "results/processed/targeted_stress_matrix/sign_tests.csv"
  |> ResultsTable.read_csv()
  |> Enum.map(fn row ->
    %{
      "profile" => row["profile"],
      "load_level" => row["load_level"],
      "test" => row["test"],
      "wins" => row["wins"],
      "losses" => row["losses"],
      "p_value" => ResultsTable.p_value(row["two_sided_sign_test_p"])
    }
  end)

ResultsTable.print_table(sign_tests, [
  {"profile", "Perfil"},
  {"load_level", "Carga"},
  {"test", "Comparación"},
  {"wins", "Victorias"},
  {"losses", "Derrotas"},
  {"p_value", "p-valor"}
])
```

## Validación QAOA

```elixir
qaoa_depth =
  "results/processed/qaoa_validation_small_matrix/by_depth.csv"
  |> ResultsTable.read_csv()
  |> Enum.map(fn row ->
    %{
      "reps" => row["reps"],
      "attempts" => row["attempts"],
      "exact_matches" => row["exact_matches"],
      "exact_match_rate" => ResultsTable.percent(row["exact_match_rate"]),
      "average_elapsed_seconds" => ResultsTable.seconds(row["average_elapsed_seconds"])
    }
  end)

ResultsTable.print_table(qaoa_depth, [
  {"reps", "Profundidad p"},
  {"attempts", "Intentos"},
  {"exact_matches", "Aciertos exactos"},
  {"exact_match_rate", "Tasa de acierto"},
  {"average_elapsed_seconds", "Tiempo promedio"}
])
```

## Validación QAOA Por Instancia

La validación QAOA no demuestra ventaja cuántica escalable. Su papel es más
acotado: comprobar que las instancias QUBO exportadas pueden consumirse desde un
flujo QAOA y recuperar soluciones óptimas en instancias pequeñas.

```elixir
qaoa_instances =
  "results/processed/qaoa_validation_small_matrix/by_instance.csv"
  |> ResultsTable.read_csv()
  |> Enum.map(fn row ->
    %{
      "scenario" => row["scenario"],
      "variables" => row["variable_count"],
      "attempts" => row["attempts"],
      "exact_rate" => ResultsTable.percent(row["exact_match_rate"]),
      "best_gap" => ResultsTable.signed_float(row["best_objective_gap"]),
      "average_elapsed_seconds" => ResultsTable.seconds(row["average_elapsed_seconds"])
    }
  end)

ResultsTable.print_table(qaoa_instances, [
  {"scenario", "Escenario"},
  {"variables", "Variables"},
  {"attempts", "Intentos"},
  {"exact_rate", "Tasa exacta"},
  {"best_gap", "Mejor brecha"},
  {"average_elapsed_seconds", "Tiempo promedio"}
])
```

## Lectura Técnica

```elixir
[
  "QUBO v1 no se comporta como reemplazo universal de las heurísticas clásicas.",
  "La señal más fuerte aparece en burst_critical/high, donde QUBO v1 gana en 90% de las seeds.",
  "La matriz dirigida respalda una arquitectura híbrida: heurísticas clásicas por defecto y QUBO como optimizador especialista.",
  "fairness_starvation funciona como resultado negativo: la formulación actual no domina cuando fairness/starvation es la presión principal.",
  "QAOA valida el flujo QUBO -> optimización cuántica variacional en instancias pequeñas, sin afirmar ventaja cuántica escalable."
]
```
