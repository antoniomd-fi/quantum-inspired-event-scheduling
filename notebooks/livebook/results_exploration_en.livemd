# Reproducible Results Exploration

This Livebook summarizes the main results of the event-driven scheduling
experiment with classical heuristics, QUBO-based strategies, and small-instance
QAOA validation.

The goal is to make the curated CSV outputs easy to inspect without external
analysis dependencies.

## Data Loading

```elixir
defmodule ResultsTable do
  @moduledoc false

  @repo_root Path.expand("../..", __DIR__)

  def read_csv(relative_path) do
    path = Path.join(@repo_root, relative_path)

    path
    |> File.read!()
    |> String.split(~r/\R/, trim: true)
    |> parse_csv()
  end

  def first_row(relative_path) do
    relative_path
    |> read_csv()
    |> List.first()
  end

  def table(rows, columns) do
    header = columns |> Enum.map(fn {_key, label} -> label end) |> Enum.join(" | ")
    separator = columns |> Enum.map(fn _ -> "---" end) |> Enum.join(" | ")

    body =
      rows
      |> Enum.map(fn row ->
        values =
          columns
          |> Enum.map(fn {key, _label} -> row |> Map.fetch!(key) |> format() end)
          |> Enum.join(" | ")

        "| #{values} |"
      end)
      |> Enum.join("\n")

    "| #{header} |\n| #{separator} |\n#{body}"
  end

  def print_table(rows, columns) do
    rows
    |> table(columns)
    |> IO.puts()
  end

  def percent(value), do: "#{Float.round(value * 100, 2)}%"
  def signed_percent(value) when value > 0, do: "+#{Float.round(value, 2)}%"
  def signed_percent(value), do: "#{Float.round(value, 2)}%"
  def signed_float(value) when value > 0, do: "+#{Float.round(value, 4)}"
  def signed_float(value), do: "#{Float.round(value, 4)}"
  def seconds(value), do: "#{Float.round(value, 2)} s"
  def p_value(value) when value == 0.0, do: "0.000000"
  def p_value(value), do: :erlang.float_to_binary(value, decimals: 6)

  defp parse_csv([header_line | rows]) do
    headers = String.split(header_line, ",")

    Enum.map(rows, fn row ->
      values = String.split(row, ",")

      headers
      |> Enum.zip(values)
      |> Map.new(fn {key, value} -> {key, cast(value)} end)
    end)
  end

  defp cast("true"), do: true
  defp cast("false"), do: false

  defp cast(value) do
    value = String.trim(value)

    cond do
      String.match?(value, ~r/^-?\d+$/) -> String.to_integer(value)
      String.match?(value, ~r/^[+-]?(\d+(\.\d*)?|\.\d+)([eE][+-]?\d+)?$/) -> value |> normalize_float() |> String.to_float()
      true -> value
    end
  end

  defp normalize_float(value) do
    if (String.contains?(value, "e") or String.contains?(value, "E")) and not String.contains?(value, ".") do
      Regex.replace(~r/^([+-]?\d+)([eE][+-]?\d+)$/, value, "\\1.0\\2")
    else
      value
    end
  end

  defp format(value) when is_float(value), do: :erlang.float_to_binary(value, decimals: 4)
  defp format(value), do: to_string(value)
end
```

## Overall Result

```elixir
v2 = ResultsTable.first_row("results/processed/extended_event_driven_matrix/summary.csv")
v3 = ResultsTable.first_row("results/processed/targeted_stress_matrix/overall_summary.csv")
qaoa = ResultsTable.first_row("results/processed/qaoa_validation_small_matrix/aggregate.csv")

%{
  "v2_general_scenarios" => v2["generated_scenario_count"],
  "v2_qubo_v1_wins" => "#{v2["qubo_v1_wins_best_classical_count"]}/#{v2["generated_scenario_count"]}",
  "v2_within_5_percent" => "#{v2["qubo_v1_within_5pct_best_classical_count"]}/#{v2["generated_scenario_count"]}",
  "v3_targeted_comparisons" => v3["comparisons"],
  "v3_qubo_v1_wins" => "#{v3["objective_win_count"]}/#{v3["comparisons"]}",
  "v3_hybrid_activation_signal" => "#{v3["hybrid_activation_signal_count"]}/#{v3["comparisons"]}",
  "qaoa_exact_match_rate" => ResultsTable.percent(qaoa["exact_match_rate"])
}
```

## Targeted Matrix

The targeted matrix focuses on cases where burstiness, high load, critical
events, worker heterogeneity, and starvation/fairness pressure overlap. The goal
is not to prove that QUBO always wins, but to identify when it becomes useful as
a specialist optimizer in a hybrid scheduling architecture.

```elixir
v3_rows =
  "results/processed/targeted_stress_matrix/profile_load_summary.csv"
  |> ResultsTable.read_csv()
  |> Enum.map(fn row ->
    %{
      "profile" => row["profile"],
      "load_level" => row["load_level"],
      "objective_win_rate" => ResultsTable.percent(row["objective_win_rate"]),
      "within_5pct_objective_rate" => ResultsTable.percent(row["within_5pct_objective_rate"]),
      "hybrid_activation_signal_rate" => ResultsTable.percent(row["hybrid_activation_signal_rate"]),
      "objective_gap_pct_mean" => ResultsTable.signed_percent(row["objective_gap_pct_mean"]),
      "critical_delta_mean" => ResultsTable.signed_float(row["critical_delta_mean"]),
      "p99_improvement_pct_mean" => ResultsTable.signed_percent(row["p99_improvement_pct_mean"])
    }
  end)

ResultsTable.print_table(v3_rows, [
  {"profile", "Profile"},
  {"load_level", "Load"},
  {"objective_win_rate", "Wins"},
  {"within_5pct_objective_rate", "Within 5%"},
  {"hybrid_activation_signal_rate", "Hybrid signal"},
  {"objective_gap_pct_mean", "Objective gap"},
  {"critical_delta_mean", "Critical delta"},
  {"p99_improvement_pct_mean", "p99 improvement"}
])
```

## Objective Gap And Confidence Intervals

Negative objective gaps mean QUBO v1 outperformed the best objective-based
classical baseline. This table is the main decision point for identifying where
the QUBO specialist is competitive.

```elixir
objective_gap_rows =
  "results/processed/targeted_stress_matrix/profile_load_summary.csv"
  |> ResultsTable.read_csv()
  |> Enum.map(fn row ->
    %{
      "profile" => row["profile"],
      "load_level" => row["load_level"],
      "mean_gap" => ResultsTable.signed_percent(row["objective_gap_pct_mean"]),
      "ci_low" => ResultsTable.signed_percent(row["objective_gap_pct_ci95_low"]),
      "ci_high" => ResultsTable.signed_percent(row["objective_gap_pct_ci95_high"]),
      "wins" => "#{row["objective_win_count"]}/#{row["comparisons"]}",
      "within_5pct" => "#{row["within_5pct_objective_count"]}/#{row["comparisons"]}"
    }
  end)

ResultsTable.print_table(objective_gap_rows, [
  {"profile", "Profile"},
  {"load_level", "Load"},
  {"mean_gap", "Mean gap"},
  {"ci_low", "CI low"},
  {"ci_high", "CI high"},
  {"wins", "Wins"},
  {"within_5pct", "Within 5%"}
])
```

## Critical Event Protection

This table shows whether QUBO v1 protects critical events better than the
objective-best classical baseline. It is important because the strongest value
of the hybrid architecture is not always lower global latency, but better
behavior under critical-event pressure.

```elixir
critical_rows =
  "results/processed/targeted_stress_matrix/profile_load_summary.csv"
  |> ResultsTable.read_csv()
  |> Enum.map(fn row ->
    %{
      "profile" => row["profile"],
      "load_level" => row["load_level"],
      "critical_delta" => ResultsTable.signed_float(row["critical_delta_mean"]),
      "ci_low" => ResultsTable.signed_float(row["critical_delta_ci95_low"]),
      "ci_high" => ResultsTable.signed_float(row["critical_delta_ci95_high"]),
      "hybrid_signal" => ResultsTable.percent(row["hybrid_activation_signal_rate"])
    }
  end)

ResultsTable.print_table(critical_rows, [
  {"profile", "Profile"},
  {"load_level", "Load"},
  {"critical_delta", "Critical delta"},
  {"ci_low", "CI low"},
  {"ci_high", "CI high"},
  {"hybrid_signal", "Hybrid signal"}
])
```

## Latency Trade-Off

Positive values mean QUBO v1 improved p99 latency over the objective-best
classical baseline. The negative average is a useful limitation: the QUBO
formulation can improve critical-event handling while still hurting tail
latency in some profiles.

```elixir
latency_rows =
  "results/processed/targeted_stress_matrix/profile_load_summary.csv"
  |> ResultsTable.read_csv()
  |> Enum.map(fn row ->
    %{
      "profile" => row["profile"],
      "load_level" => row["load_level"],
      "p99_mean" => ResultsTable.signed_percent(row["p99_improvement_pct_mean"]),
      "ci_low" => ResultsTable.signed_percent(row["p99_improvement_pct_ci95_low"]),
      "ci_high" => ResultsTable.signed_percent(row["p99_improvement_pct_ci95_high"]),
      "starvation_delta" => row["starvation_delta_mean"]
    }
  end)

ResultsTable.print_table(latency_rows, [
  {"profile", "Profile"},
  {"load_level", "Load"},
  {"p99_mean", "p99 improvement"},
  {"ci_low", "CI low"},
  {"ci_high", "CI high"},
  {"starvation_delta", "Starvation delta"}
])
```

## Paired Sign Tests

The sign tests compare seed-level wins and losses. They help separate a true
dominance signal from cases where QUBO v1 only stays close to classical
heuristics.

```elixir
sign_tests =
  "results/processed/targeted_stress_matrix/sign_tests.csv"
  |> ResultsTable.read_csv()
  |> Enum.map(fn row ->
    %{
      "profile" => row["profile"],
      "load_level" => row["load_level"],
      "test" => row["test"],
      "wins" => row["wins"],
      "losses" => row["losses"],
      "p_value" => ResultsTable.p_value(row["two_sided_sign_test_p"])
    }
  end)

ResultsTable.print_table(sign_tests, [
  {"profile", "Profile"},
  {"load_level", "Load"},
  {"test", "Comparison"},
  {"wins", "Wins"},
  {"losses", "Losses"},
  {"p_value", "p-value"}
])
```

